# MapTiler API Key
# Get your free key from: https://cloud.maptiler.com/account/
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here

# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
# IMPORTANT: Do NOT include /rest/v1/ in the URL. The Supabase client adds this automatically.
# CORRECT: https://your-project.supabase.co
# INCORRECT: https://your-project.supabase.co/rest/v1/
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
